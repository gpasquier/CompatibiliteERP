<Window x:Class="CompatibiliteERP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
        Title="Analyseur de compatibilité ERP"
        Width="1500" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Analyseur de compatibilité ERP"
                           FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Normalisation • extraction technique • règles de compatibilité • explication"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#E8F0FE" CornerRadius="8" Padding="14,8">
                <TextBlock Text=".NET 8 • WPF" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Height="38"
                             VerticalContentAlignment="Center"
                             FontSize="15"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="Rechercher"
                            Click="Search_Click"
                            MinWidth="120"/>

                    <Button Grid.Column="2"
                            Content="Analyser"
                            Click="Analyze_Click"
                            MinWidth="110"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="2,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Text="Astuce : utiliser * pour imposer le début de désignation. Exemple : VIS CHC *6"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Résultats -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Références" FontSize="17" FontWeight="SemiBold" Margin="6,4,6,10"/>
                    <ListView x:Name="ResultsList"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedArticle}"
                              SelectionChanged="ResultsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Designation}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding SousFamille}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Article sélectionné -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Référence analysée" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedArticle.Code}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedArticle.Designation}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="140"
                                    Height="140"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Background="#F8FAFC">
                                <Image Source="{Binding ImageSelectionnee}"
                                       Stretch="Uniform"
                                       Margin="6"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Classification" FontWeight="SemiBold"/>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Famille" Grid.Row="0"/>
                            <TextBlock Text="{Binding SelectedArticle.Famille}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Réf. fournisseur" Grid.Row="1"/>
                            <TextBlock Text="{Binding SelectedArticle.ReferenceFournisseur}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Réf. fabricant" Grid.Row="2"/>
                            <TextBlock Text="{Binding SelectedArticle.ReferenceFabricant}" Grid.Row="2" Grid.Column="1"/>
                        </Grid>

                        <TextBlock Text="Caractéristiques extraites" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Dimension 1" Grid.Row="0"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Dimension1}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Dimension 2" Grid.Row="1"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Dimension2}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Dimension 3" Grid.Row="2"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Dimension3}" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Text="Dimension 4" Grid.Row="3"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Dimension4}" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Text="Matière" Grid.Row="4"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Matiere}" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Text="Traitement" Grid.Row="5"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Traitement}" Grid.Row="5" Grid.Column="1"/>

                            <TextBlock Text="Norme" Grid.Row="6"/>
                            <TextBlock Text="{Binding SelectedArticle.Caracteristiques.Norme}" Grid.Row="6" Grid.Column="1"/>
                        </Grid>

                        <TextBlock Text="Confiance d'extraction" FontWeight="SemiBold" Margin="0,18,0,5"/>
                        <ProgressBar Height="10" Maximum="1" Value="{Binding SelectedArticle.ConfianceExtraction}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Compatibilités -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Candidats compatibles"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="4,4,4,10"/>

                    <Expander Grid.Row="1"
                              Header="Pondération des critères"
                              IsExpanded="False"
                              Margin="0,0,0,12">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Famille" Grid.Row="0" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightFamille, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{Binding Weights.WeightFamille, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Réf. fournisseur" Grid.Row="1" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightReferenceFournisseur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="{Binding Weights.WeightReferenceFournisseur, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Réf. fabricant" Grid.Row="2" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightReferenceFabricant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="{Binding Weights.WeightReferenceFabricant, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Diamètre intérieur" Grid.Row="3" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightDim2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Text="{Binding Weights.WeightDim2, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Diamètre extérieur" Grid.Row="4" VerticalAlignment="Center"/>
                            <Slider Grid.Row="4" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightDim3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2"
                                       Text="{Binding Weights.WeightDim3, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Épaisseur" Grid.Row="5" VerticalAlignment="Center"/>
                            <Slider Grid.Row="5" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightDim4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="5" Grid.Column="2"
                                       Text="{Binding Weights.WeightDim4, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Matière" Grid.Row="6" VerticalAlignment="Center"/>
                            <Slider Grid.Row="6" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightMatiere, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2"
                                       Text="{Binding Weights.WeightMatiere, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Norme" Grid.Row="7" VerticalAlignment="Center"/>
                            <Slider Grid.Row="7" Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Weights.WeightNorme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="7" Grid.Column="2"
                                       Text="{Binding Weights.WeightNorme, StringFormat={}{0:0}}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Expander>

                    <ListView Grid.Row="2"
                              x:Name="CompatibilitiesList"
                              ItemsSource="{Binding Compatibilities}"
                              SelectedItem="{Binding SelectedCompatibility}">
                        <ListView.Resources>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Niveau}" Value="Compatible">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Niveau}" Value="Sous_conditions">
                                        <Setter Property="Background" Value="LightYellow"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Niveau}" Value="Incompatible">
                                        <Setter Property="Background" Value="LightCoral"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding Score}" Width="65">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Score" Tag="Score"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Niveau}" Width="125">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Compatibilité" Tag="Niveau"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Candidat.Code}" Width="115">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Référence" Tag="Candidat.Code"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Candidat.Designation}" Width="260">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Désignation" Tag="Candidat.Designation"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Candidat.Famille}" Width="120">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Famille" Tag="Candidat.Famille"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Candidat.ReferenceFournisseur}" Width="140">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Réf. fournisseur" Tag="Candidat.ReferenceFournisseur"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Candidat.ReferenceFabricant}" Width="140">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Réf. fabricant" Tag="Candidat.ReferenceFabricant"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedCompatibility}">
                                <TextBlock Text="Détail de comparaison"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>

                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Référence" Grid.Row="0" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Candidat.Code}" Grid.Row="0" Grid.Column="1"/>

                                        <TextBlock Text="Désignation" Grid.Row="1" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Candidat.Designation}"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Famille" Grid.Row="2" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Candidat.Famille}"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Margin="0,6,0,0"/>

                                        <TextBlock Text="Réf. fournisseur" Grid.Row="3" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Candidat.ReferenceFournisseur}"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Margin="0,6,0,0"/>

                                        <TextBlock Text="Réf. fabricant" Grid.Row="4" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Candidat.ReferenceFabricant}"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Margin="0,6,0,0"/>
                                    </Grid>

                                    <Border Grid.Column="1"
                                            Width="110"
                                            Height="110"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="8"
                                            BorderBrush="#D0D7DE"
                                            BorderThickness="1"
                                            Background="#F8FAFC">
                                        <Image Source="{Binding DataContext.ImageCompatibiliteSelectionnee, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Stretch="Uniform"
                                               Margin="6"/>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Criteres}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nom}"/>
                                                <TextBlock Text="{Binding Resultat}" Grid.Column="1"/>
                                                <TextBlock Text="{Binding Points, StringFormat={}{0:0.#}}" Grid.Column="2" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Alertes" FontWeight="SemiBold" Margin="0,14,0,5"/>
                                <ItemsControl ItemsSource="{Binding Alertes}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding Status}"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="4,14,0,0"/>

        <ProgressBar x:Name="LoadingProgressBar"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Height="20"
                     Margin="0,10,0,0"/>
    </Grid>
</Window>
